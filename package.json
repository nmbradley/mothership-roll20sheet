{
  "dependencies": {
    "npm-run-all": "^4.1.5",
    "pug": "^3.0.4",
    "pug-cli": "^1.0.0-alpha6"
  },
  "scripts": {
    "start": "npm-run-all --parallel watch:*",
    "build": "npm-run-all --serial build:svelte build:translations",
    "build:svelte": "node scripts/build-svelte.js",
    "watch:svelte": "nodemon --watch src --watch scripts -e svelte,js,ts,scss,html --exec 'npm run build:svelte'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "lint:css": "stylelint \"src/svelte/**/*.{scss,svelte}\"",
    "lint:css:fix": "stylelint \"src/svelte/**/*.{scss,svelte}\" --fix",
    "build:translations": "node scripts/build-translations.js"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-svelte": "^3.23.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.2",
    "nodemon": "^3.1.14",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.6",
    "sass": "^1.80.6",
    "stylelint": "^17.14.1",
    "stylelint-order": "^8.1.1",
    "svelte": "^5.56.10",
    "svelte-eslint-parser": "^1.8.1",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.68.0",
    "vitest": "^0.28.5"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "eslint --fix"
    ],
    "*.{scss,svelte}": [
      "stylelint --fix"
    ]
  },
  "imports": {
    "#game/*": "./src/game/*",
    "#rules/*": "./src/ts/rules/*",
    "#data/*": "./src/game/data/*",
    "#svelte/*": "./src/svelte/*"
  }
}
