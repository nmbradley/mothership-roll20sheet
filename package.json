{
  "dependencies": {
    "npm-run-all": "^4.1.5",
    "pug": "^3.0.4",
    "pug-cli": "^1.0.0-alpha6"
  },
  "scripts": {
    "start": "npx npm-run-all --parallel compile:sass compile:pug compile:ts",
    "compile:sass": "sass ./src/scss/mothership.scss ./mothership.css",
    "compile:pug": "npx pug src/pug/mothership.pug -o ./ -w -P",
    "compile:ts": "tsdown",
    "test": "vitest run",
    "compile:svelte": "node scripts/build-svelte.js",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.9.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-svelte": "^3.23.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "sass": "^1.80.6",
    "svelte": "^5.56.10",
    "svelte-eslint-parser": "^1.8.1",
    "tsdown": "^0.14.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.68.0",
    "vitest": "^0.28.5"
  },
  "type": "module",
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "eslint --fix"
    ]
  }
}